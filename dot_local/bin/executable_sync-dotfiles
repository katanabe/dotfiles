#!/bin/bash
set -euo pipefail

CHEZMOI_DIR="$HOME/.local/share/chezmoi"

# Sync Ghostty GUI config to chezmoi-managed config
GHOSTTY_GUI_CONFIG="$HOME/Library/Application Support/com.mitchellh.ghostty/config"
GHOSTTY_CONFIG="$HOME/.config/ghostty/config"
if [ -f "$GHOSTTY_GUI_CONFIG" ]; then
  cp "$GHOSTTY_GUI_CONFIG" "$GHOSTTY_CONFIG"
fi

# Update Brewfile
/opt/homebrew/bin/brew bundle dump --file="$HOME/.config/Brewfile" --force

# Re-add all managed files to chezmoi (picks up any changes)
/opt/homebrew/bin/chezmoi re-add

# Commit and push if there are changes
cd "$CHEZMOI_DIR"
git add -A

# `git stash` is a no-op when there is nothing to save, so an unconditional pop
# afterwards resurrects an unrelated older stash. Only pop what this run pushed.
stashed=0
if ! git diff --cached --quiet; then
  git stash push --quiet
  stashed=1
fi

git pull --rebase || exit 1

if [ "$stashed" -eq 1 ]; then
  # A conflicted pop leaves markers in the tree and keeps the stash around, so
  # an unattended retry would replay the same conflict every day.
  if ! git stash pop; then
    echo "sync-dotfiles: stash pop conflicted; resolve manually" >&2
    exit 1
  fi
fi

# Apply any changes from remote to disk
/opt/homebrew/bin/chezmoi apply --force

if [ -n "$(git status --porcelain)" ]; then
  git add -A
  if git diff --cached | grep -q '^+<<<<<<< '; then
    echo "sync-dotfiles: refusing to commit conflict markers" >&2
    exit 1
  fi
  git commit -m "auto: sync dotfiles $(date +%Y-%m-%d)"
  git push
fi
